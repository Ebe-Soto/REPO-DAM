<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grupos"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitulo_grupos"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Buscador real: antes era un TextView con el hint escrito como texto fijo,
                     lo que impedía que el usuario pudiera escribir. Ahora es un EditText de
                     verdad, listo para que se le agregue un TextWatcher. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/cd_buscar"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/etBuscarGrupos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/hint_buscar_grupos"
                android:importantForAutofill="no"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Tabs: ahora son realmente pul-sables (clickable + focusable + ripple),
                     antes eran TextView sin ninguna respuesta táctil. -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/tvTodos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/tab_todos"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvFavoritos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/tab_favoritos"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGrupos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="@string/grupos"
                    android:textColor="@color/purple_primary"
                    android:textStyle="bold" />

                <View
                    android:layout_width="46dp"
                    android:layout_height="2dp"
                    android:background="@drawable/bg_underline_tab" />
            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Id-agregado para que se puedan inflar/agregar filas de grupo
                 dinámicamente (o cambiarlo a RecyclerView más adelante). -->

            <LinearLayout
                android:id="@+id/containerGrupos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Fila de grupo de ejemplo, ahora en una tarjeta real (MaterialCardView)
                     con elevación y esquinas redondeadas en vez de un LinearLayout con
                     fondo blanco plano; y es clickable de verdad para abrir el detalle. -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrupoEjemplo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checkable="false"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:rippleColor="@color/purple_light"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_group_icon"
                            android:contentDescription="@string/cd_icono_grupo"
                            android:padding="9dp"
                            android:src="@drawable/ic_group"
                            app:tint="@color/purple_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNombreGrupoItem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/placeholder_nombre_grupo"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMiembrosItem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/placeholder_miembros"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/cd_ver_grupo"
                            android:src="@android:drawable/ic_media_play"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Botón crear grupo: antes era un TextView disfrazado de botón.
    Ahora es un FloatingActionButton real de Material Components,
    con su ripple, elevación y sombra ya incluidos por el propio
    componente (no hay que simularlos a mano). -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCrearGrupo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/cd_crear_grupo"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/purple_pill_bg"
        app:tint="@color/purple_primary" />

</FrameLayout>